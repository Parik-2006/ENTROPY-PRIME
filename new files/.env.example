# ============================================================
#  ENTROPY PRIME — Environment Variable Template
#  Copy to .env.local for local dev, never commit .env.local
#  Copy to .env.prod for production, never commit .env.prod
# ============================================================

# ── MongoDB ────────────────────────────────────────────────────
# Root credentials (used only during DB initialisation / dev override)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Application user (created by scripts/mongo-init.js)
MONGO_APP_USER=ep_user
MONGO_APP_PASSWORD=CHANGE_ME_APP_PASSWORD_HERE
MONGO_DB_NAME=entropy_prime

# ── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_MAX_MEM=256mb

# ── Core Secrets — ALL MUST BE ROTATED FROM DEFAULTS ──────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
EP_SESSION_SECRET=GENERATE_AND_SET_HERE
EP_SHADOW_SECRET=GENERATE_AND_SET_HERE
EP_API_KEY_SECRET=GENERATE_AND_SET_HERE

# ── JWT (RS256) ─────────────────────────────────────────────────
# Provide EITHER the path (mounted into the container) OR inline PEM
EP_JWT_PUBLIC_KEY_PATH=/app/certs/jwt_public.pem
EP_JWT_AUDIENCE=entropy-prime-admin

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Server ─────────────────────────────────────────────────────
HTTP_PORT=80
UVICORN_WORKERS=4
SERVER_NAME=localhost

# ── ML Checkpoints ─────────────────────────────────────────────
EP_RL_CHECKPOINT=checkpoints/governor.pt
EP_MAB_CHECKPOINT=checkpoints/mab.json
EP_PPO_CHECKPOINT=checkpoints/watchdog.pt
EP_GOV_PPO_CHECKPOINT=checkpoints/governor_ppo.pt
