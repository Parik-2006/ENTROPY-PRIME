# Entropy Prime — Environment Variable Template
# ----------------------------------------------------------------------------
# Copy to `.env` (backend) / `.env.local` (frontend) and fill with REAL values.
# NEVER commit real secrets. This template intentionally contains no secrets.
# In production, set these in the Render (backend) and Vercel (frontend) dashboards.

# ── MongoDB Atlas (backend) ───────────────────────────────────────────────────
# Primary (deployment standard). Legacy MONGODB_URL is still accepted as fallback.
MONGODB_URI=
MONGODB_DB_NAME=entropy_prime
# Legacy alias (optional; MONGODB_URI takes precedence):
MONGODB_URL=

# ── Redis (backend) ───────────────────────────────────────────────────────────
# The app's redis-py client uses the rediss:// protocol URL (REDIS_URL).
# Upstash REST creds are documented for reference / future REST usage.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy aliases (optional; any one is accepted):
REDIS_URI=
EP_REDIS_URL=

# ── Security / auth (backend) ─────────────────────────────────────────────────
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SECRET_KEY=
EP_SESSION_SECRET=
EP_API_KEY_SECRET=
# HMAC secret for honeypot / shadow challenges (accepts SHADOW_SECRET or EP_SHADOW_SECRET).
SHADOW_SECRET=
EP_SHADOW_SECRET=

# ── CORS (backend) ────────────────────────────────────────────────────────────
# Comma-separated exact origins. *.vercel.app is also allowed via CORS_ORIGIN_REGEX.
# Note: the local demo frontend (Vite) runs on port 3001.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ── Backend server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Point the SPA at the deployed backend.
VITE_API_BASE_URL=
VITE_BACKEND_URL=
# Legacy alias (optional; VITE_API_BASE_URL takes precedence):
VITE_API_URL=
